# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Places (optional — more reliable than Playwright for Maps; enable if set)
# https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=
GOOGLE_EMBED_API_KEY=
MAPBOX_API_KEY=

# Optional: read secrets from OS keyring if env vars above are empty.
# Service defaults to "ann-arbor-automated"; username/account is the secret key name.
# AADE_KEYRING_SERVICE=ann-arbor-automated

# Scraper: use "playwright" or "places" (if GOOGLE_PLACES_API_KEY is set)
AADE_MAPS_SOURCE=playwright

# Project paths
AADE_DB_PATH=./data/aade.db
AADE_SCREENSHOT_DIR=./output/screenshots

# Model for outreach
AADE_OUTREACH_MODEL=gpt-4o
